@model IEnumerable<TarijaReadApp.Models.Ejemplar>

@{ ViewData["Title"] = "Ejemplares"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Ejemplares</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Ejemplar</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped shadow-sm">
            <thead class="table-dark">
                <tr><th>Código</th><th>Estado</th><th>Libro</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Codigo</td>
                        <td>@item.Estado</td>
                        <td>@item.Libro?.Titulo</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>