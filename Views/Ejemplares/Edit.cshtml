@model TarijaReadApp.Models.Ejemplar

@{ ViewData["Title"] = "Editar Ejemplar"; }

<div class="container mt-4">
    <h2 class="text-primary">Editar Ejemplar</h2>

    <form asp-action="Edit" method="post" class="card p-4 shadow-sm">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" class="form-control" asp-items="Html.GetEnumSelectList<TarijaReadApp.Models.EstadoEjemplar>()"></select>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="LibroId" class="form-label">Libro</label>
                <select asp-for="LibroId" asp-items="ViewBag.LibroId" class="form-control"></select>
                <span asp-validation-for="LibroId" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
            <button type="submit" class="btn btn-success">Guardar Cambios</button>
        </div>
    </form>
</div>