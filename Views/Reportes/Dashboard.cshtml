@{
    ViewData["Title"] = "Dashboard - TarijaRead";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">📊 Dashboard de Biblioteca</h2>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <a href="@Url.Action("DescargarExcel")" class="btn btn-success w-100">
                📥 Descargar Catálogo (Excel)
            </a>
        </div>
        <div class="col-md-6 mb-3">
            <a href="@Url.Action("DescargarPdf")" class="btn btn-danger w-100">
                📄 Descargar Catálogo (PDF)
            </a>
        </div>
    </div>

    <div class="card p-4 shadow-sm">
        <h5>Libros por Categoría</h5>
        <canvas id="miGrafico" width="400" height="200"></canvas>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    async function cargarGrafico() {
        try {
            const res = await fetch("/Reportes/DatosGrafico");
            if (!res.ok) throw new Error("No se pudo cargar el gráfico");
            const datos = await res.json();

           new Chart(document.getElementById('miGrafico'), {
            type: 'bar',
            data: {
            labels: datos.map(d => d.etiqueta),
            datasets: [{
                label: 'Cantidad de Libros',
                data: datos.map(d => d.valor),
                backgroundColor: [
                    'rgba(54, 162, 235, 0.7)',
                    'rgba(255, 99, 132, 0.7)',
                    'rgba(255, 206, 86, 0.7)',
                    'rgba(75, 192, 192, 0.7)',
                    'rgba(153, 102, 255, 0.7)',
                    'rgba(255, 159, 64, 0.7)',
                    'rgba(46, 204, 113, 0.7)'
                    ],
                borderColor: [
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 99, 132, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)',
                    'rgba(46, 204, 113, 1)'
                    ],
                        borderWidth: 1,
                        borderRadius: 6
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false }
        },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
    }
});
        } catch (error) {
            document.querySelector('.card').innerHTML += `<p class="text-danger">${error.message}</p>`;
        }
    }

    cargarGrafico();
</script>
}