@model IEnumerable<TarijaReadApp.Models.Libro>

@{ ViewData["Title"] = "Libros"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Libros</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Libro</a>
    </div>

    <div class="mb-3">
        <button id="btnCargar" class="btn btn-info">Cargar Inventario vía AJAX</button>
    </div>

    <div id="listaLibros" class="mt-3"></div>

    <div class="table-responsive">
        <table class="table table-striped shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>ISBN</th>
                    <th>Categoría</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Titulo</td>
                        <td>@item.Autor</td>
                        <td>@item.ISBN</td>
                        <td>@item.Categoria?.Nombre</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById("btnCargar").addEventListener("click", async () => {
        const contenedor = document.getElementById("listaLibros");
        contenedor.innerHTML = '<div class="spinner-border text-primary"></div>';

        try {
            const respuesta = await fetch("/api/LibrosApi");
            if (!respuesta.ok) throw new Error("Error en la red");

            const datos = await respuesta.json();

            contenedor.innerHTML = "";
            datos.forEach(l => {
                contenedor.innerHTML += `
                    <div class="alert alert-secondary">
                        <strong>${l.titulo}</strong> — ${l.autor}
                        <br><small>Categoría: ${l.categoria} ${l.isbn ? '| ISBN: ' + l.isbn : ''}</small>
                    </div>`;
            });
        } catch (error) {
            contenedor.innerHTML = `<p class="text-danger">Error: ${error.message}</p>`;
        }
    });
</script>
}