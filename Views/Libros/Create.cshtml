@model TarijaReadApp.Models.Libro

@{ ViewData["Title"] = "Nuevo Libro"; }

<div class="container mt-4">
    <h2 class="text-primary">Registrar Nuevo Libro</h2>

    <form asp-action="Create" method="post" class="card p-4 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ej: Cien años de soledad" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="ISBN" class="form-label"></label>
                <input asp-for="ISBN" class="form-control" placeholder="Ej: 978-3-16" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Autor" class="form-label"></label>
                <input asp-for="Autor" class="form-control" placeholder="Ej: Gabriel García Márquez" />
                <span asp-validation-for="Autor" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CategoriaId" class="form-label">Categoría</label>
                <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-control">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
            <button type="submit" class="btn btn-success">Guardar Registro</button>
        </div>
    </form>
</div>