@model IEnumerable<TarijaReadApp.Models.Prestamo>

@{ ViewData["Title"] = "Préstamos"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Préstamos</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Préstamo</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Ejemplar</th>
                    <th>Socio</th>
                    <th>Registrado por</th>
                    <th>Salida</th>
                    <th>Límite</th>
                    <th>Devolución</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Ejemplar?.Codigo — @item.Ejemplar?.Libro?.Titulo</td>
                        <td>@item.Socio?.Nombre</td>
                        <td>@item.Usuario?.Nombre</td>
                        <td>@item.FechaSalida.ToShortDateString()</td>
                        <td>@item.FechaLimite.ToShortDateString()</td>
                        <td>@(item.FechaDevolucion?.ToShortDateString() ?? "Pendiente")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>