@using TarijaReadApp.ViewModels
@{
    ViewData["Title"] = "TarijaRead - Panel Principal";

    var modulos = new List<ModuloCardViewModel>
    {
        new() { Titulo = "Categorías", Descripcion = "Gestiona las categorías de libros", Controller = "Categorias" },
        new() { Titulo = "Libros", Descripcion = "Catálogo de libros registrados", Controller = "Libros" },
        new() { Titulo = "Ejemplares", Descripcion = "Copias físicas de cada libro", Controller = "Ejemplares" },
        new() { Titulo = "Socios", Descripcion = "Usuarios que solicitan préstamos", Controller = "Socios" },
        new() { Titulo = "Préstamos", Descripcion = "Registro de salidas y devoluciones", Controller = "Prestamos" },
        new() { Titulo = "Multas", Descripcion = "Penalizaciones por mora", Controller = "Multas" },
        new() { Titulo = "Usuarios", Descripcion = "Personal administrativo y bibliotecarios", Controller = "Usuarios" }
    };
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 text-primary">📚 TarijaRead</h1>
        <p class="text-muted">Sistema de Gestión de Biblioteca</p>
    </div>

    <div class="row g-4">
        @foreach (var modulo in modulos)
        {
            <partial name="_ModuloCard" model="modulo" />
        }
    </div>
</div>