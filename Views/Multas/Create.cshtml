@model TarijaReadApp.ViewModels.MultaCreateViewModel

@{ ViewData["Title"] = "Nueva Multa"; }

<div class="container mt-4">
    <h2 class="text-primary">Registrar Nueva Multa</h2>

    <form asp-action="Create" method="post" class="card p-4 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PrestamoId" class="form-label">Préstamo</label>
                <select asp-for="PrestamoId" asp-items="ViewBag.PrestamoId" class="form-control">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="PrestamoId" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Monto" class="form-label"></label>
                <input asp-for="Monto" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="PagoRealizado" class="form-check-input" />
                    <label asp-for="PagoRealizado" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
            <button type="submit" class="btn btn-success">Guardar Registro</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}